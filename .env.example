# ZERO1 Education — environment template.
# Copy to .env.local and fill in to run against a real Firebase project.
# With none of these set the app runs in demo mode: bundled curriculum,
# seeded classroom data and localStorage progress. Zero setup required.

# 'demo' = seeded demo data (default) · 'live' = Firebase-backed adapters
NEXT_PUBLIC_ZERO1_MODE=demo

# Web API key — Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain, e.g. zero1-education.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Project id, e.g. zero1-education
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Storage bucket holding submission uploads, e.g. zero1-education.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Cloud Messaging sender id (numeric) — used by notifications
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web app id, e.g. 1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics measurement id (G-XXXXXXXXXX) — leave empty for student surfaces
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
